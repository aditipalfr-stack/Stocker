# Stocker Environment Configuration

# -----------------------------------------------------------------------------
# AI / LLM Document Intelligence Providers
# (Configure at least one to enable live AI analysis on Concalls & Annual Reports)
# -----------------------------------------------------------------------------

# Google Gemini API Key (Recommended / Preferred)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Server Port Configuration (Optional)
# -----------------------------------------------------------------------------
BACKEND_PORT=8088
FRONTEND_PORT=5188
